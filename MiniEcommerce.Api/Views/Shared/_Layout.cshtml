<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiniEcommerce</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-shopping-cart me-2"></i>MiniEcommerce
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        @if (Context.Session.GetString("Usuario") != null)
                        {
                          var usuarioJson = Context.Session.GetString("Usuario");
                          var usuario = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(usuarioJson);
                          var perfil = usuario.GetProperty("Perfil").GetString();
                          var nome = usuario.GetProperty("Nome").GetString();

                          <li class="nav-item">
                              <a class="nav-link" href="/Home/Index">
                                  <i class="fas fa-home me-1"></i>Início
                              </a>
                          </li>

                          @if (perfil == "Administrador" || perfil == "1")
                          {
                              <li class="nav-item">
                                  <a class="nav-link" href="/Produtos/Index">
                                      <i class="fas fa-box me-1"></i>Gerenciar Produtos
                                  </a>
                              </li>
                              <li class="nav-item">
                                  <a class="nav-link" href="/Pedidos/MeusPedidos">
                                      <i class="fas fa-shopping-bag me-1"></i>Gerenciar Pedidos
                                  </a>
                              </li>
                              <li class="nav-item">
                                  <a class="nav-link" href="/Cupom/Index">
                                      <i class="fas fa-ticket-alt me-1"></i>Gerenciar Cupons
                                  </a>
                              </li>
                              <li class="nav-item">
                                  <a class="nav-link" href="/Cadastro/Index">
                                      <i class="fas fa-shopping-bag me-1"></i>Cadastrar Usuario
                                  </a>
                              </li>
                              <li class="nav-item">
                                  <a class="nav-link" href="/Carrinho/Index">
                                      <i class="fas fa-shopping-cart me-1"></i>Carrinho
                                      <span class="badge bg-danger" id="carrinho-count">0</span>
                                  </a>
                              </li>
                          }
                          else
                          {
                              <li class="nav-item">
                                  <a class="nav-link" href="/Carrinho/Index">
                                      <i class="fas fa-shopping-cart me-1"></i>Carrinho
                                      <span class="badge bg-danger" id="carrinho-count">0</span>
                                  </a>
                              </li>
                              <li class="nav-item">
                                  <a class="nav-link" href="/Pedidos/MeusPedidos">
                                      <i class="fas fa-list me-1"></i>Meus Pedidos
                                  </a>
                              </li>
                          }

                          <li class="nav-item dropdown">
                              <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                  <i class="fas fa-user me-1"></i>@nome
                              </a>
                              <ul class="dropdown-menu dropdown-menu-end">
                                  <li>
                                      <a class="dropdown-item" href="#" onclick="logout()">
                                          <i class="fas fa-sign-out-alt me-1"></i>Sair
                                      </a>
                                  </li>
                              </ul>
                          </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Autenticacao/Login">
                                    <i class="fas fa-sign-in-alt me-1"></i>Entrar
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 bg-light">
        <div class="container text-center">
            <span class="text-muted">© 2024 MiniEcommerce - Todos os direitos reservados</span>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function logout() {
            if (confirm('Deseja realmente sair?')) {
                $.post('/Autenticacao/Logout', function() {
                    window.location.href = '/Autenticacao/Login';
                });
            }
        }

        function atualizarContadorCarrinho() {
            $.get('/Carrinho/Obter', function(response) {
                if (response.sucesso && response.dados) {
                    var total = response.dados.itens ? response.dados.itens.length : 0;
                    $('#carrinho-count').text(total);
                }
            });
        }

        $(document).ready(function() {
            atualizarContadorCarrinho();
        });
    </script>
</body>
</html>
