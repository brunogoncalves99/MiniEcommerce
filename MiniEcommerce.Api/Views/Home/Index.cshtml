@{
    ViewData["Title"] = "Catálogo de Produtos";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2><i class="fas fa-store me-2"></i>Catálogo de Produtos</h2>
            <p class="text-muted">Confira nossos produtos disponíveis</p>
        </div>
    </div>

    <!-- Filtros -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" id="buscarProduto" class="form-control" placeholder="Buscar produtos...">
            </div>
        </div>
        <div class="col-md-3">
            <select id="filtroCategoria" class="form-select">
                <option value="">Todas as Categorias</option>
                <option value="Eletrônicos">Eletrônicos</option>
                <option value="Periféricos">Periféricos</option>
                <option value="Componentes">Componentes</option>
                <option value="Acessórios">Acessórios</option>
            </select>
        </div>
        <div class="col-md-3">
            <select id="ordenar" class="form-select">
                <option value="nome">Nome (A-Z)</option>
                <option value="preco-asc">Menor Preço</option>
                <option value="preco-desc">Maior Preço</option>
            </select>
        </div>
    </div>

    <!-- Loading -->
    <div id="loading" class="text-center my-5" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
        <p class="mt-2">Carregando produtos...</p>
    </div>

    <!-- Grid de Produtos -->
    <div class="row" id="produtos-container">
        <!-- Produtos serão carregados aqui via AJAX -->
    </div>

    <!-- Mensagem quando não há produtos -->
    <div id="sem-produtos" class="alert alert-info text-center" style="display: none;">
        <i class="fas fa-info-circle me-2"></i>Nenhum produto encontrado
    </div>
</div>

@section Scripts {
    <script>
        let todosProdutos = [];

        $(document).ready(function() {
            carregarProdutos();

            // Event listeners para filtros
            $('#buscarProduto').on('keyup', filtrarProdutos);
            $('#filtroCategoria').on('change', filtrarProdutos);
            $('#ordenar').on('change', filtrarProdutos);
        });

        function carregarProdutos() {
            $('#loading').show();
            $('#produtos-container').empty();

            $.ajax({
                url: '/Produtos/ObterTodos',
                type: 'GET',
                success: function(response) {
                    $('#loading').hide();

                    if (response.sucesso && response.dados) {
                        todosProdutos = response.dados;
                        exibirProdutos(todosProdutos);
                    } else {
                        $('#sem-produtos').show();
                    }
                },
                error: function() {
                    $('#loading').hide();
                    Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'Erro ao carregar produtos'
                    });
                }
            });
        }

        function exibirProdutos(produtos) {
            var container = $('#produtos-container');
            container.empty();

            if (produtos.length === 0) {
                $('#sem-produtos').show();
                return;
            }

            $('#sem-produtos').hide();

            produtos.forEach(function(produto) {
                var imagemUrl = produto.imagemUrl || '/images/produto-default.jpg';
                var estoqueClass = produto.quantidadeEstoque > 0 ? 'text-success' : 'text-danger';
                var estoqueTexto = produto.quantidadeEstoque > 0
                    ? produto.quantidadeEstoque + ' em estoque'
                    : 'Sem estoque';

                var card = `
                    <div class="col-md-4 col-lg-3 mb-4">
                        <div class="card h-100 produto-card">
                            <img src="${imagemUrl}" class="card-img-top produto-img" alt="${produto.nome}">
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-secondary mb-2 align-self-start">${produto.categoria}</span>
                                <h5 class="card-title">${produto.nome}</h5>
                                <p class="card-text text-muted small flex-grow-1">${produto.descricao || ''}</p>
                                <div class="mt-auto">
                                    <h4 class="text-primary mb-2">R$ ${produto.preco.toFixed(2)}</h4>
                                    <p class="small ${estoqueClass} mb-3">
                                        <i class="fas fa-box me-1"></i>${estoqueTexto}
                                    </p>
                                    ${produto.quantidadeEstoque > 0 ? `
                                        <button class="btn btn-primary w-100" onclick="adicionarAoCarrinho(${produto.id}, '${produto.nome}', ${produto.preco}, '${imagemUrl}')">
                                            <i class="fas fa-cart-plus me-2"></i>Adicionar ao Carrinho
                                        </button>
                                    ` : `
                                        <button class="btn btn-secondary w-100" disabled>
                                            <i class="fas fa-times me-2"></i>Indisponível
                                        </button>
                                    `}
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                container.append(card);
            });
        }

        function filtrarProdutos() {
            var busca = $('#buscarProduto').val().toLowerCase();
            var categoria = $('#filtroCategoria').val();
            var ordenacao = $('#ordenar').val();

            var produtosFiltrados = todosProdutos.filter(function(produto) {
                var matchBusca = produto.nome.toLowerCase().includes(busca) ||
                               (produto.descricao && produto.descricao.toLowerCase().includes(busca));
                var matchCategoria = !categoria || produto.categoria === categoria;

                return matchBusca && matchCategoria;
            });

            // Ordenar
            if (ordenacao === 'nome') {
                produtosFiltrados.sort((a, b) => a.nome.localeCompare(b.nome));
            } else if (ordenacao === 'preco-asc') {
                produtosFiltrados.sort((a, b) => a.preco - b.preco);
            } else if (ordenacao === 'preco-desc') {
                produtosFiltrados.sort((a, b) => b.preco - a.preco);
            }

            exibirProdutos(produtosFiltrados);
        }

        function adicionarAoCarrinho(id, nome, preco, imagem) {
            var item = {
                produtoId: id,
                nome: nome,
                preco: preco,
                imagemUrl: imagem,
                quantidade: 1
            };

            $.ajax({
                url: '/Carrinho/Adicionar',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(item),
                success: function(response) {
                    if (response.sucesso) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Sucesso!',
                            text: 'Produto adicionado ao carrinho!',
                            timer: 1500,
                            showConfirmButton: false
                        });
                        atualizarContadorCarrinho();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Erro!',
                            text: response.mensagem
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'Erro ao adicionar produto ao carrinho'
                    });
                }
            });
        }
    </script>

    <style>
        .produto-card {
            transition: transform 0.2s, box-shadow 0.2s;
            border: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

            .produto-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        .produto-img {
            height: 200px;
            object-fit: cover;
        }
    </style>
}
