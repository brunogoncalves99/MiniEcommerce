@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - MiniEcommerce</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-container {
            max-width: 450px;
            width: 100%;
            padding: 20px;
        }
        .login-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            overflow: hidden;
        }
        .login-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .login-header i {
            font-size: 3rem;
            margin-bottom: 10px;
        }
        .login-body {
            padding: 40px;
        }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        .btn-login {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px;
            font-weight: bold;
            transition: transform 0.2s;
        }
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }
        .input-group-text {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <i class="fas fa-shopping-cart"></i>
                <h2 class="mb-0">MiniEcommerce</h2>
                <p class="mb-0 small">Faça login para continuar</p>
            </div>
            <div class="login-body">
                <form id="loginForm">
                    <div class="mb-3">
                        <label for="cpf" class="form-label">CPF</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-id-card"></i>
                            </span>
                            <input type="text" class="form-control" id="cpf" name="cpf" 
                                   placeholder="Digite seu CPF (apenas números)" 
                                   maxlength="11" required>
                        </div>
                        <small class="form-text text-muted">Digite apenas os 11 dígitos</small>
                    </div>

                    <div class="mb-3">
                        <label for="senha" class="form-label">Senha</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-lock"></i>
                            </span>
                            <input type="password" class="form-control" id="senha" name="senha" 
                                   placeholder="Digite sua senha" required>
                            <button class="btn btn-outline-secondary" type="button" id="toggleSenha">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-login w-100 mb-3">
                        <i class="fas fa-sign-in-alt me-2"></i>Entrar
                    </button>

                    <a href="/Cadastro/Index" class="btn btn-outline-primary w-100">
                        <i class="fas fa-user-plus me-2"></i>Criar Conta
                    </a>
                </form>

                <hr class="my-4">

                    @*<div class="alert alert-info small mb-0">
                    <strong>Credenciais de teste:</strong><br>
                    <strong>Admin:</strong> CPF: 12345678901 | Senha: admin123<br>
                    <strong>Comprador:</strong> CPF: 98765432100 | Senha: comprador123
                </div> *@
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            // Máscara para CPF
            $('#cpf').on('input', function() {
                this.value = this.value.replace(/\D/g, '');
            });

            // Toggle mostrar/ocultar senha
            $('#toggleSenha').click(function() {
                var senhaInput = $('#senha');
                var icon = $(this).find('i');
                
                if (senhaInput.attr('type') === 'password') {
                    senhaInput.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    senhaInput.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // Submit do formulário
            $('#loginForm').submit(function(e) {
                e.preventDefault();

                var cpf = $('#cpf').val().trim();
                var senha = $('#senha').val();

                if (cpf.length !== 11) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'CPF deve ter 11 dígitos'
                    });
                    return;
                }

                if (senha.length < 6) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'Senha deve ter no mínimo 6 caracteres'
                    });
                    return;
                }

                // Mostrar loading
                Swal.fire({
                    title: 'Entrando...',
                    text: 'Por favor aguarde',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // Fazer requisição
                $.ajax({
                    url: '/Autenticacao/Login',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        cpf: cpf,
                        senha: senha
                    }),
                    success: function(response) {
                        if (response.sucesso) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Sucesso!',
                                text: response.mensagem,
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = '/Home/Index';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Erro!',
                                text: response.mensagem
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'Erro!',
                            text: 'Erro ao fazer login. Tente novamente.'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>
