@{
    ViewData["Title"] = "Gerenciar Usuários";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-users me-2"></i>Gerenciar Usuários</h2>
            <p class="text-muted mb-0">Crie e gerencie usuários para ter acesso ao sistema</p>
        </div>
        <button class="btn btn-primary" id="btnNovoUsuario">
            <i class="fas fa-plus me-2"></i>Novo Usuário
        </button>
    </div>

    <div id="loading" class="text-center my-5" style="display: none;">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Carregando usuários...</p>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover" id="tabelaUsuarios">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>CPF</th>
                        <th>Email</th>
                        <th>Perfil</th>
                        <th>Ativo</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Usuário -->
<div class="modal fade" id="modalUsuarios" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitulo">
                    <i class="fas fa-user me-2"></i>Novo Usuário
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="formUsuarios">
                    <input type="hidden" id="usuarioId" value="0">

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label for="nome" class="form-label">
                                <i class="fas fa-user me-1"></i>Nome Completo *
                            </label>
                            <input type="text" class="form-control" id="nome" required maxlength="200">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="cpf" class="form-label">
                                <i class="fas fa-id-card me-1"></i>CPF *
                            </label>
                            <input type="text" class="form-control" id="cpf"
                                   placeholder="000.000.000-00" maxlength="14" required>
                            <div class="invalid-feedback">CPF inválido</div>
                            <div class="valid-feedback">CPF válido</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="email" class="form-label">
                                <i class="fas fa-envelope me-1"></i>Email *
                            </label>
                            <input type="email" class="form-control" id="email" required maxlength="255">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="senha" class="form-label">
                                <i class="fas fa-lock me-1"></i>Senha *
                            </label>
                            <input type="password" class="form-control" id="senha"
                                   placeholder="Mínimo 6 caracteres" minlength="6" required>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="confirmarSenha" class="form-label">
                                <i class="fas fa-lock me-1"></i>Confirmar Senha *
                            </label>
                            <input type="password" class="form-control" id="confirmarSenha"
                                   minlength="6" required>
                            <div class="invalid-feedback">As senhas não conferem</div>
                            <div class="valid-feedback">Senhas conferem</div>
                        </div>

                        <div class="col-12 mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="isAdmin">
                                <label class="form-check-label" for="isAdmin">
                                    <strong>Cadastrar como Administrador</strong>
                                </label>
                                <small class="form-text text-muted d-block">
                                    Deixe desmarcado para cadastrar como Comprador
                                </small>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                <i class="fas fa-toggle-on me-1"></i>Status
                            </label>
                            <select class="form-select" id="ativo">
                                <option value="true">Ativo</option>
                                <option value="false">Inativo</option>
                            </select>
                        </div>

                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btnSalvar">
                    <i class="fas fa-save me-1"></i>Salvar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalUsuarios = new bootstrap.Modal(document.getElementById('modalUsuarios'));

        $(document).ready(function() {
            carregarUsuarios();


            $('#cpf').on('input', function() {
                let valor = $(this).val().replace(/\D/g, '');

                if (valor.length > 11) {
                    valor = valor.substr(0, 11);
                }

                if (valor.length === 11) {
                    $(this).val(formatarCPF(valor)); 
                } else {
                    $(this).val(valor);
                }
            });

            $('#cpf').on('blur', function() {
                let cpf = $(this).val().replace(/\D/g, '');

                if (cpf.length === 0) {
                    $(this).removeClass('is-valid is-invalid');
                    return;
                }
            });


            $('#confirmarSenha').on('blur', function() {
                let senha = $('#senha').val();
                let confirmar = $(this).val();

                if (confirmar.length === 0) {
                    $(this).removeClass('is-valid is-invalid');
                    return;
                }

                if (senha === confirmar) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                } else {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                }
            });

            $('#btnNovoUsuario').click(abrirModalNovo);
            $('#btnSalvar').click(salvarUsuario);
        });


        function carregarUsuarios() {
            $('#loading').show();
            $('#tabelaUsuarios tbody').empty();

            $.ajax({
                url: '/Cadastro/ListarUsuarios',
                type: 'GET',
                success: function(usuarios) {
                    $('#loading').hide();
                    exibirUsuarios(usuarios);
                },
                error: function() {
                    $('#loading').hide();
                    mostrarErro('Erro ao carregar usuários');
                }
            });
        }

        function exibirUsuarios(usuarios) {
            let tbody = $('#tabelaUsuarios tbody');
            tbody.empty();

            if (!usuarios || usuarios.length === 0) {
                tbody.append(`
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            <i class="fas fa-users fa-3x mb-2"></i>
                            <p>Nenhum usuário cadastrado</p>
                        </td>
                    </tr>
                `);
                return;
            }

            usuarios.forEach(function(usuario) {
                let perfilBadge = usuario.perfil === 1
                    ? '<span class="badge bg-danger">Admin</span>'
                    : '<span class="badge bg-info">Comprador</span>';

                let ativoBadge = usuario.ativo
                    ? '<span class="badge bg-success">Sim</span>'
                    : '<span class="badge bg-secondary">Não</span>';

                let cpfFormatado = formatarCPF(usuario.cpf); 

                let row = `
                    <tr>
                        <td><strong>#${usuario.id}</strong></td>
                        <td>${usuario.nome}</td>
                        <td>${cpfFormatado}</td>
                        <td>${usuario.email}</td>
                        <td>${perfilBadge}</td>
                        <td>${ativoBadge}</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-warning me-1" onclick="editarUsuario(${usuario.id})"
                                    title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deletarUsuario(${usuario.id})"
                                    title="Deletar">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        function abrirModalNovo() {
            $('#modalTitulo').html('<i class="fas fa-user me-2"></i>Novo Usuário');
            $('#formUsuarios')[0].reset();
            $('#usuarioId').val('0');
            $('#isAdmin').prop('checked', false);

            $('#cpf, #confirmarSenha').removeClass('is-valid is-invalid');

            modalUsuarios.show();
        }

        function editarUsuario(id) {
            
            $.ajax({
                url: '/Cadastro/BuscarUsuario?id=' + id,
                type: 'GET',
                success: function(usuario) {
                    if (!usuario) {
                        mostrarErro('Usuário não encontrado'); 
                        return;
                    }
                    debugger;
                    $('#modalTitulo').html('<i class="fas fa-edit me-2"></i>Editar Usuário');
                    $('#usuarioId').val(usuario.id);
                    $('#nome').val(usuario.nome);
                    $('#cpf').val(formatarCPF(usuario.cpf));
                    $('#email').val(usuario.email);

                    $('#isAdmin').prop('checked', usuario.perfil === 1);

                    $('#senha').val('');
                    $('#confirmarSenha').val('');

                    $('#ativo').val(usuario.ativo ? 'true' : 'false');


                    $('#cpf, #confirmarSenha').removeClass('is-valid is-invalid');

                    modalUsuarios.show();
                },
                error: function() {
                    mostrarErro('Erro ao buscar usuário'); 
                }
            });
        }


        function salvarUsuario() {
            // Pegar valores
            let nome = $('#nome').val().trim();
            let cpf = $('#cpf').val().replace(/\D/g, '');
            let email = $('#email').val().trim();
            let senha = $('#senha').val();
            let confirmarSenha = $('#confirmarSenha').val();
            let isAdmin = $('#isAdmin').is(':checked');
            let ativo = $('#ativo').val() === 'true';

            if (!nome) {
                mostrarErro('O nome é obrigatório'); 
                $('#nome').focus();
                return;
            }

            if (!validarCPF(cpf)) { 
                mostrarErro('CPF inválido'); 
                $('#cpf').focus();
                return;
            }

            if (!email) {
                mostrarErro('O email é obrigatório');
                $('#email').focus();
                return;
            }

            if (!senha) {
                mostrarErro('A senha é obrigatória');
                $('#senha').focus();
                return;
            }

            if (senha.length < 6) {
                mostrarErro('A senha deve ter no mínimo 6 caracteres');
                $('#senha').focus();
                return;
            }

            if (!confirmarSenha) {
                mostrarErro('A confirmação de senha é obrigatória');
                $('#confirmarSenha').focus();
                return;
            }

            if (senha !== confirmarSenha) {
                mostrarErro('As senhas não conferem');
                $('#confirmarSenha').focus();
                return;
            }

            let perfil = isAdmin ? 1 : 2;

            let usuario = {
                id: parseInt($('#usuarioId').val()) || 0,
                nome: nome,
                cpf: cpf, 
                email: email,
                senha: senha,
                perfil: perfil,
                ativo : ativo
            };

            mostrarLoading('Salvando...'); 

            $.ajax({
                url: '/Cadastro/Cadastrar',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(usuario),
                success: function(response) {
                    fecharLoading(); 

                    if (response.sucesso) {
                        mostrarSucesso(response.mensagem); 
                        modalUsuarios.hide();
                        carregarUsuarios();
                    } else {
                        mostrarErro(response.mensagem);
                    }
                },
                error: function(xhr) {
                    fecharLoading();

                    let mensagem = 'Erro ao salvar usuário';
                    if (xhr.responseJSON && xhr.responseJSON.mensagem) {
                        mensagem = xhr.responseJSON.mensagem;
                    }

                    mostrarErro(mensagem);
                }
            });
        }

        function deletarUsuario(id) {
            confirmar('Deseja realmente deletar este usuário?', 'Confirmar Exclusão') 
                .then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Cadastro/Excluir?id=' + id,
                            type: 'DELETE',
                            success: function(response) {
                                if (response.sucesso) {
                                    mostrarSucesso(response.mensagem); 
                                    carregarUsuarios();
                                } else {
                                    mostrarErro(response.mensagem);
                                }
                            },
                            error: function() {
                                mostrarErro('Erro ao deletar usuário');
                            }
                        });
                    }
                });
        }
    </script>
}
