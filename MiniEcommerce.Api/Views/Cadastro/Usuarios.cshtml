@{
    ViewData["Title"] = "Gerenciar Usuários";
    Layout = null;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-ticket-alt me-2"></i>Gerenciar cadastro de usuarios no sistema</h2>
            <p class="text-muted mb-0">Crie e gerencie usuarios para ter acesso ao sistema</p>
        </div>
        <button class="btn btn-primary" id="btnNovoCupom">
            <i class="fas fa-plus me-2"></i>Novo Cupom
        </button>
    </div>

    <div id="loading" class="text-center my-5" style="display: none;">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Carregando usuarios...</p>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover" id="tabelaCupons">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>CPF</th>
                        <th>Perfil</th>
                        <th>Email</th>
                        <th>Ativo</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalUsuarios" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitulo">
                    <i class="fas fa-ticket-alt me-2"></i>Novo Usuario
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="formUsuarios">
                    <input type="hidden" id="usuarioId" value="0">

                    <div class="row">
                        <div class="mb-3">
                            <label for="nome" class="form-label">Nome Completo</label>
                            <input type="text" class="form-control" id="nome" required>
                        </div>

                        <div class="mb-3">
                            <label for="cpf" class="form-label">CPF</label>
                            <input type="text" class="form-control" id="cpf"
                                   placeholder="Digite apenas números" maxlength="11" required>
                            <small class="form-text text-muted">11 dígitos, sem pontos ou traços</small>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" required>
                        </div>

                        <div class="mb-3">
                            <label for="senha" class="form-label">Senha</label>
                            <input type="password" class="form-control" id="senha"
                                   placeholder="Mínimo 6 caracteres" required>
                        </div>

                        <div class="mb-3">
                            <label for="confirmarSenha" class="form-label">Confirmar Senha</label>
                            <input type="password" class="form-control" id="confirmarSenha" required>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="isAdmin">
                            <label class="form-check-label" for="isAdmin">
                                Cadastrar como <strong>Administrador</strong>
                            </label>
                            <small class="form-text text-muted d-block">
                                Deixe desmarcado para cadastrar como Comprador
                            </small>
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btnSalvar">
                    <i class="fas fa-save me-1"></i>Salvar
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    let modalUsuarios = new bootstrap.Modal(document.getElementById('modalUsuarios'));


    $(document).ready(function() {

        $('#btnNovoCupom').click(function() {
            abrirModalNovo();
        });

        $('#btnSalvar').click(function() {
            salvarUsuario();
        });

    });

    function carregarUsuarios(){

    }

    function salvarUsuario(){
        var senha = $('#senha').val().trim();
        var confirmacaoSenha = $('#confirmacaoSenha').val().trim();
        var NomeUsuario = $('#nome').val().trim();
        var CPFUsuario = $('#cpf').val().trim();
        var Email = $('#email').val().trim();

        var CPFUsuario = $(this).val();
        if (!validarCPF(CPFUsuario)) {
            alert('CPF inválido!');
        }

        if(!NomeUsuario){
            Swal.fire('Atenção!', 'O nome do usuário é obrigatório', 'warning');
                $('#nome').focus();
           return;
        }

        if(!CPFUsuario){
            Swal.fire('Atenção!', 'O nome do usuário é obrigatório', 'warning');
                $('#cpf').focus();
           return;
        }

        if(!Email){
            Swal.fire('Atenção!', 'O Email é obrigatório', 'warning');
                $('#email').focus();
           return;
        }

        if (!senha || !confirmacaoSenha) {
              Swal.fire('Atenção!', 'A senha e confirmação de senha são obrigatórios', 'warning');
           if (!senha) { 
               $('#senha').focus();
           } else {
               $('#confirmacaoSenha').focus();
           }
           return;
        }

        if (senha !== confirmacaoSenha) {
             Swal.fire({
                 icon: 'error',
                 title: 'Erro!',
                 text: 'As senhas não conferem'
             });
             return;
        }

        if (senha.length < 6) {
             Swal.fire({
                 icon: 'error',
                 title: 'Erro!',
                 text: 'Senha deve ter no mínimo 6 caracteres'
             });
             return;
        }

        Swal.fire({
            title: 'Cadastrando...',
            text: 'Por favor aguarde',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.ajax({
            url: 'Cadastro/Cadastrar',
            type: 'POST',
            contextType: 'aplication/json',
            data: JSON.stringify({
                nome: NomeUsuario,
                cpf: CPFUsuario,
                email: Email,
                senha: senha,
                isAdmin: $('#isAdmin').is(':checked')
            }),
            sucess: function(response){
                 Swal.close();

                if (response.sucesso) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Sucesso!',
                        text: response.mensagem,
                        timer: 2000,
                        showConfirmButton: false
                    });

                    modalUsuarios.hide();
                    carregarUsuarios();
                }
            },
            error: function(xhr) {
                 Swal.close();
                
                 let mensagem = 'Erro ao salvar usuario';
                 if (xhr.responseJSON && xhr.responseJSON.mensagem) {
                     mensagem = xhr.responseJSON.mensagem;
                 }
                
                 Swal.fire({
                     icon: 'error',
                     title: 'Erro!',
                     text: mensagem
                 });
            }

        });
    }

    function editarUsuario(id) {
        $.ajax({
            url: '/Cadastro/BuscarUsuario?id=' + id,
            type: 'GET',
            success: function(cupom) {
                if (!cupom) {
                    Swal.fire('Erro!', 'Usuário não encontrado', 'error');
                    return;
                }

                $('#modalTitulo').html('<i class="fas fa-edit me-2"></i>Editar Usuario');
                $('#cupomId').val(cupom.id);
                $('#codigo').val(cupom.codigo);
                $('#percentualDesconto').val(cupom.percentualDesconto);
                $('#valorMinimoCompra').val(cupom.valorMinimoCompra || '');
                $('#valorMaximoDesconto').val(cupom.valorMaximoDesconto || '');

                // Converter data para formato yyyy-MM-dd
                let data = new Date(cupom.dataValidade);
                $('#dataValidade').val(data.toISOString().split('T')[0]);

                $('#quantidadeMaximaUso').val(cupom.quantidadeMaximaUso || '');
                $('#quantidadeUsada').val(cupom.quantidadeUsada);
                $('#ativo').val(cupom.ativo.toString());

                $('#divQuantidadeUsada').show();
                calcularExemplo();
                modalCupom.show();
            },
            error: function() {
                Swal.fire('Erro!', 'Erro ao buscar cupom', 'error');
            }
        });
    }



</script>