@{
    ViewData["Title"] = "Cadastro de Usuário";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cadastro - MiniEcommerce</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .cadastro-container {
            max-width: 500px;
            width: 100%;
        }
        .cadastro-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            overflow: hidden;
        }
        .cadastro-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .cadastro-body {
            padding: 40px;
        }
        .btn-cadastro {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="cadastro-container">
        <div class="cadastro-card">
            <div class="cadastro-header">
                <i class="fas fa-user-plus fa-3x mb-3"></i>
                <h2 class="mb-0">Cadastro de Usuário</h2>
                <p class="mb-0 small">Preencha os dados abaixo</p>
            </div>
            <div class="cadastro-body">
                <form id="cadastroForm">
                    <div class="mb-3">
                        <label for="nome" class="form-label">Nome Completo</label>
                        <input type="text" class="form-control" id="nome" required>
                    </div>

                    <div class="mb-3">
                        <label for="cpf" class="form-label">CPF</label>
                        <input type="text" class="form-control" id="cpf" 
                               placeholder="Digite apenas números" maxlength="11" required>
                        <small class="form-text text-muted">11 dígitos, sem pontos ou traços</small>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" required>
                    </div>

                    <div class="mb-3">
                        <label for="senha" class="form-label">Senha</label>
                        <input type="password" class="form-control" id="senha" 
                               placeholder="Mínimo 6 caracteres" required>
                    </div>

                    <div class="mb-3">
                        <label for="confirmarSenha" class="form-label">Confirmar Senha</label>
                        <input type="password" class="form-control" id="confirmarSenha" required>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="isAdmin">
                        <label class="form-check-label" for="isAdmin">
                            Cadastrar como <strong>Administrador</strong>
                        </label>
                        <small class="form-text text-muted d-block">
                            Deixe desmarcado para cadastrar como Comprador
                        </small>
                    </div>

                    <button type="submit" class="btn btn-primary btn-cadastro w-100 mb-3">
                        <i class="fas fa-save me-2"></i>Cadastrar
                    </button>

                    <a href="/Autenticacao/Login" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-arrow-left me-2"></i>Voltar para Login
                    </a>
                </form>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            // Máscara CPF
            $('#cpf').on('input', function() {
                this.value = this.value.replace(/\D/g, '');
            });

            // Submit
            $('#cadastroForm').submit(function(e) {
                e.preventDefault();

                var cpf = $('#cpf').val().trim();
                var senha = $('#senha').val();
                var confirmarSenha = $('#confirmarSenha').val();

                // Validações
                if (cpf.length !== 11) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'CPF deve ter 11 dígitos'
                    });
                    return;
                }

                if (senha.length < 6) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'Senha deve ter no mínimo 6 caracteres'
                    });
                    return;
                }

                if (senha !== confirmarSenha) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'As senhas não conferem'
                    });
                    return;
                }

                Swal.fire({
                    title: 'Cadastrando...',
                    text: 'Por favor aguarde',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '/Cadastro/Cadastrar',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        nome: $('#nome').val(),
                        cpf: cpf,
                        email: $('#email').val(),
                        senha: senha,
                        isAdmin: $('#isAdmin').is(':checked')
                    }),
                    success: function(response) {
                        if (response.sucesso) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Sucesso!',
                                text: response.mensagem,
                                confirmButtonText: 'Ir para Login'
                            }).then(() => {
                                window.location.href = '/Autenticacao/Login';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Erro!',
                                text: response.mensagem
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'Erro!',
                            text: 'Erro ao cadastrar usuário'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>
